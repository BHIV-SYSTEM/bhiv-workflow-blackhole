{
  "name": "niyantran-employee-agent-v2",
  "version": "2.0.0-phase-c",
  "description": "Niyantran Employee Monitoring V2 - Lightweight, Privacy-First Windows Desktop Agent",
  "main": "src/agent.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build:helper": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /r:System.Security.dll /r:System.Windows.Forms.dll /r:System.Drawing.dll /out:bin\\NiyantranWin32Helper.exe native-src\\NiyantranWin32Helper.cs",
    "agent:pair": "node src/cli.js pair",
    "agent:run": "node src/cli.js run",
    "agent:status": "node src/cli.js status",
    "install:win": "powershell -ExecutionPolicy Bypass -File installer/install-agent.ps1",
    "uninstall:win": "powershell -ExecutionPolicy Bypass -File installer/uninstall-agent.ps1"
  },
  "keywords": [
    "niyantran",
    "monitoring-v2",
    "privacy-first"
  ],
  "author": "Niyantran Engineering",
  "license": "UNLICENSED",
  "private": true
}
